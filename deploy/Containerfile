ARG PYTHON_IMAGE=python:3.13.13-slim-bookworm@sha256:355bfa66770995d7e9a0da4b3473b44d0cb451f6b56f5615ad9c39e3c4eca03f
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.19@sha256:b46b03ddfcfbf8f547af7e9eaefdf8a39c8cebcba7c98858d3162bd28cf536f6

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS core-builder
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /build
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --extra proxy --no-install-project
COPY src/ ./src/
RUN uv sync --frozen --no-dev --extra proxy --no-editable

FROM ${PYTHON_IMAGE} AS workspace-builder
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /build
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --extra workspace --no-install-project
COPY src/ ./src/
RUN uv sync --frozen --no-dev --extra workspace --no-editable

FROM ${PYTHON_IMAGE} AS workspace-runner
ARG AL1S_VERSION=2.0.0
LABEL org.opencontainers.image.title="AL1S Workspace" \
      org.opencontainers.image.version="${AL1S_VERSION}" \
      org.opencontainers.image.source="https://github.com/SCU-Maker-Org/AL1S" \
      org.opencontainers.image.licenses="MIT"
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get -o Acquire::Retries=5 update; \
    installed=0; \
    for attempt in 1 2 3 4 5; do \
      if apt-get -o Acquire::Retries=5 --fix-broken install -y --fix-missing \
          --no-install-recommends \
        && apt-get -o Acquire::Retries=5 install -y --fix-missing \
          --no-install-recommends bubblewrap ca-certificates git; then \
        installed=1; break; \
      fi; \
      sleep 2; \
    done; \
    test "$installed" = 1; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /workspaces; \
    chown -R 10001:10001 /workspaces
COPY --from=workspace-builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    HOME=/workspaces \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8000 \
    AL1S_CONFIG_FILE=/etc/al1s/config.toml \
    AL1S_WORKSPACE_ROOT=/workspaces
USER 10001:10001
WORKDIR /workspaces
EXPOSE 8000
ENTRYPOINT ["al1s-workspace-server"]

FROM ${PYTHON_IMAGE} AS core
ARG AL1S_VERSION=2.0.0
LABEL org.opencontainers.image.title="AL1S" \
      org.opencontainers.image.description="Lightweight Telegram and Discord AI assistant" \
      org.opencontainers.image.version="${AL1S_VERSION}" \
      org.opencontainers.image.source="https://github.com/SCU-Maker-Org/AL1S" \
      org.opencontainers.image.licenses="MIT"
COPY --from=core-builder /opt/venv /opt/venv
COPY config.example.toml /usr/share/al1s/config.example.toml
RUN mkdir -p /etc/al1s /var/lib/al1s /run/al1s /var/cache/al1s \
    && chown -R 10001:10001 /var/lib/al1s /run/al1s /var/cache/al1s
ENV PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin \
    HOME=/var/lib/al1s \
    AL1S_CONTAINER=1 \
    AL1S_CONFIG_FILE=/etc/al1s/config.toml \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
WORKDIR /var/lib/al1s
VOLUME ["/var/lib/al1s"]
ENTRYPOINT ["al1s"]
CMD ["run"]
